# MySQL
DB_ROOT_PASSWORD=replace_with_a_strong_root_password
DB_PASSWORD=your_mysql_password

# Optional host ports
FRONTEND_PORT=8080
BACKEND_PORT=8082
PROMETHEUS_PORT=9090

# Optional build metadata (Release workflow injects these automatically)
APP_VERSION=dev
APP_COMMIT=unknown
APP_BUILD_TIME=unknown

# JWT
JWT_SECRET=replace_with_a_32_plus_chars_random_secret
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_HOURS=168

# Public registration (disable after provisioning users when self-hosting)
REGISTRATION_ENABLED=true

# Browser and reverse-proxy security
COOKIE_SECURE=false
TRUSTED_PROXIES=

# One-time administrator bootstrap (used by the bootstrap-admin command)
# BOOTSTRAP_ADMIN_USERNAME=admin
# BOOTSTRAP_ADMIN_PASSWORD=replace_with_a_strong_password

# Redis (required when APP_ENV=production)
REDIS_ENABLED=false
REDIS_ADDR=127.0.0.1:6379
REDIS_DB=0
# REDIS_PASSWORD=
# Runtime safety profile (development, test, or production)
APP_ENV=development
